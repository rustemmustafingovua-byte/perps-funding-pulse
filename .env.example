# Copy to .env and fill in. Never commit .env.

# Base address that receives USDC and ETH. Required before paid calls succeed.
# Checksummed or lowercase. There is no default.
X402_PAY_TO=

# USD charged for each paid call. USDC has 6 decimals, so 0.001 is 1000 units.
PRICE_USD=0.001

# Optional. Public Base RPC works for low volume. Use your own endpoint in production.
BASE_RPC=https://mainnet.base.org

# Optional pin for the ETH/USD rate. When unset, the server reads Binance then CoinGecko.
# ETH payments are refused if no rate is available.
# ETH_USD_PRICE=

# How long a direct transfer stays redeemable, in seconds.
PAYMENT_MAX_AGE_SECONDS=900

# Free preview calls per hour, then payment is required. Paid calls per hour. Enterprise cap.
FREE_LIMIT=20
PAID_LIMIT=200
ENTERPRISE_LIMIT=1000
FUNDING_RPM=30

# Required to issue paid or enterprise keys and to read /keys and /usage.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=

# Set to 1 when the process is behind a proxy that overwrites X-Forwarded-For (Render does).
# Leave unset when clients connect directly, or callers can rotate the header for a fresh free quota.
TRUST_PROXY=

# Standard x402 PAYMENT-SIGNATURE settlement. Leave empty to accept only direct transfers
# (X-PAYMENT-TX). The public facilitator at https://x402.org/facilitator does not settle
# Base mainnet (eip155:8453). Point this at a facilitator that does, such as Coinbase CDP:
# https://api.cdp.coinbase.com/platform/v2/x402
X402_FACILITATOR_URL=
# Full header value, or a raw token (sent as "Bearer <token>").
X402_FACILITATOR_AUTH=
# X402_FACILITATOR_AUTH_HEADER=authorization

# Spent payment ids, keys, and quotas. Mount a volume here so replays do not reset on restart.
DATA_FILE=/data/state.json

PORT=8780

# Optional POST target for request/revenue summaries.
# DASHBOARD_WEBHOOK_URL=
